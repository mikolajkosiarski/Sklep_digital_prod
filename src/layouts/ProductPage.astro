---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import StarRating from '../components/ui/StarRating.astro';
import ProductGallery from '../components/product/ProductGallery.astro';
import ProductPrice from '../components/product/ProductPrice.astro';
import ProductPurchase from '../components/product/ProductPurchase.astro';
import ProductTabs from '../components/product/ProductTabs.astro';
import ProductFilm from '../components/product/ProductFilm.astro';
import RelatedProducts from '../components/product/RelatedProducts.astro';
import {
  coverFile,
  hasSales,
  productCode,
  productPath,
  sales,
  salesSourceNote,
  styleLabels,
  type DigitalProduct,
} from '../lib/catalog';
import type { DigitalOffer } from '../lib/offers';
import { getProductGallery, getSocialImage } from '../lib/product-media';
import { absoluteUrl } from '../lib/paths';
import '../styles/components/product-detail.css';

interface Props {
  product: DigitalProduct;
  offer: DigitalOffer;
}
const { product, offer } = Astro.props;
const images = await getProductGallery(product);
const socialImage = await getSocialImage(coverFile(product));
const code = productCode(product.id);
const title = `${product.title} · ${offer.designCount} designs`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  sku: code,
  description: product.description,
  image: absoluteUrl(socialImage, Astro.site),
  url: absoluteUrl(productPath(product), Astro.site),
  brand: { '@type': 'Brand', name: 'Visamore' },
  category: 'Digital design collections',
  ...(offer.rating && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: offer.rating.average,
      reviewCount: offer.rating.count,
    },
  }),
  // Reference prices do not represent an available checkout offer.
};
---

<BaseLayout
  title={`${title} — Visamore`}
  description={product.description}
  section="shop"
  schema={schema}
  ogImage={socialImage}
  ogAlt={title}
>
  <main id="main-content" class="vm-container product-page">
    <Breadcrumbs items={[{ label: 'Shop', href: '/shop/' }, { label: product.title }]} />
    <article class="product-article" aria-labelledby="product-title">
      <div class="product-hero">
        <header class="product-heading">
          <h1 id="product-title" class="page-title">
            {product.title}
          </h1>
          <p class="product-code">
            <span>{code}</span>
            <span aria-hidden="true">·</span>
            <span>{product.styles.map((style) => styleLabels[style]).join(', ')}</span>
          </p>
          {offer.rating ? (
            <a class="product-rating-link" href="#panel-reviews">
              <StarRating average={offer.rating.average} count={offer.rating.count} />
            </a>
          ) : (
            offer.reviews.length > 0 && (
              <a class="product-text-link" href="#panel-reviews">
                {offer.reviews.length} selected {offer.reviews.length === 1 ? 'review' : 'reviews'}
              </a>
            )
          )}
          <ProductPrice productId={product.id} />
          <p class="product-stock">
            <span class="product-stock__dot" aria-hidden="true"></span>
            Available · digital download
          </p>
          <p class="product-format">
            {offer.designCount} designs · {product.formatLabel}
          </p>
        </header>
        <div class="product-visual">
          <ProductGallery
            id={`gallery-${product.id}`}
            images={images}
            label={`${product.title} listing gallery`}
          />
        </div>
        <div class="product-summary">
          <p class="product-lead">{product.description}</p>
          <ProductPurchase productKey={`digital:${product.id}`} code={code} title={product.title} />
          <p class="product-availability">
            Store preview: checkout is a demo and no payment is taken.
          </p>
          {hasSales(product) && (
            <div class="product-sales">
              <p>
                <strong>{sales[product.id]}</strong> Etsy sales
              </p>
              <p class="product-sales-note">{salesSourceNote}</p>
            </div>
          )}
        </div>
      </div>
      <ProductTabs product={product} offer={offer} code={code}>
        <slot />
      </ProductTabs>
      {offer.video && <ProductFilm video={offer.video} title={product.title} />}
    </article>
    <RelatedProducts ids={offer.relatedIds} />
  </main>
</BaseLayout>
