---
interface Props {
  platform: string;
}
const { platform } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {platform === 'Instagram' ? (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none" />
    </>
  ) : platform === 'Pinterest' ? (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M9 20l3-12m-1 7c6 4 10-10 2-10-5 0-7 6-4 9" />
    </>
  ) : platform === 'TikTok' ? (
    <path d="M14 3v13a4 4 0 1 1-4-4m4-9c.5 4 3 6 7 6M14 6c1.5 3 3.5 4 7 4" />
  ) : (
    <>
      <circle cx="12" cy="12" r="8" />
      <path d="M4 12h16M12 4c-5 5-5 11 0 16M12 4c5 5 5 11 0 16" />
    </>
  )}
</svg>
