---
import type { StoreProduct } from '../../lib/storefront';
import { formatMoney } from '../../lib/money';
import Icon from '../ui/Icon.astro';
interface Props {
  product: StoreProduct;
}
const { product } = Astro.props;
const quantityId = `quantity-${product.key.replace(/[^a-z0-9]+/gi, '-')}`;
---

<tr class="cart-row" data-cart-row={product.key} hidden>
  <th scope="row" class="cart-row__product">
    <a class="cart-row__image" href={product.href} tabindex="-1" aria-hidden="true">
      <img
        src={product.image.src}
        srcset={product.image.srcset}
        sizes="4.5rem"
        alt=""
        width={product.image.width}
        height={product.image.height}
        loading="lazy"
        decoding="async"
      />
    </a>
    <span class="cart-row__name">
      <a href={product.href}>{product.title}</a>
      <span class="cart-row__meta">{product.code} · Standard license</span>
    </span>
  </th>
  <td class="cart-row__price" data-label="Price">
    {formatMoney(product.priceMinor)}
  </td>
  <td class="cart-row__quantity" data-label="Quantity">
    <label class="sr-only" for={quantityId}>
      Quantity for {product.title}
    </label>
    <input
      id={quantityId}
      type="number"
      inputmode="numeric"
      min="1"
      max={product.maxQuantity}
      step="1"
      value="1"
      data-cart-quantity={product.key}
    />
  </td>
  <td class="cart-row__total" data-label="Total" data-line-total>
    {formatMoney(product.priceMinor)}
  </td>
  <td class="cart-row__remove">
    <button
      class="cart-remove"
      type="button"
      data-cart-remove={product.key}
      aria-label={`Remove ${product.title} from cart`}
    >
      <Icon name="trash" />
    </button>
  </td>
</tr>
