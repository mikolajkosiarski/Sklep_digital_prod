---
import type { StoreProduct } from '../../lib/storefront';
import { formatMoney } from '../../lib/money';
interface Props {
  product: StoreProduct;
}
const { product } = Astro.props;
const quantityId = `cart-quantity-${product.key.replace(':', '-')}`;
---

<article class="cart-line" data-cart-row={product.key} aria-label={product.title} hidden>
  <a class="cart-line-image" href={product.href} aria-label={`View ${product.title}`}>
    <img
      src={product.image.src}
      srcset={product.image.srcset}
      sizes="96px"
      alt={product.image.alt}
      width={product.image.width}
      height={product.image.height}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="cart-line-info">
    <h2>
      <a href={product.href}>{product.title}</a>
    </h2>
    <p>
      {product.kind === 'digital' ? 'Digital' : 'Physical'} · {product.meta}
    </p>
    <p>{formatMoney(product.priceMinor)} each</p>
  </div>
  <p class="cart-line-total">
    <span class="cart-total-label">Item total</span>
    <strong data-line-total>{formatMoney(product.priceMinor)}</strong>
  </p>
  <div class="cart-line-controls">
    {product.kind === 'physical' ? (
      <div class="cart-quantity" role="group" aria-label={`Quantity for ${product.title}`}>
        <button
          type="button"
          data-cart-step="-1"
          data-cart-key={product.key}
          aria-label={`Decrease quantity for ${product.title}`}
          disabled
        >
          −
        </button>
        <label class="sr-only" for={quantityId}>
          Quantity for {product.title}
        </label>
        <input
          id={quantityId}
          type="number"
          inputmode="numeric"
          min="1"
          max="99"
          step="1"
          value="1"
          data-cart-quantity={product.key}
        />
        <button
          type="button"
          data-cart-step="1"
          data-cart-key={product.key}
          aria-label={`Increase quantity for ${product.title}`}
        >
          +
        </button>
      </div>
    ) : (
      <span class="cart-digital-quantity">Quantity: 1</span>
    )}
    <button
      class="cart-remove"
      type="button"
      data-cart-remove={product.key}
      aria-label={`Remove ${product.title}`}
    >
      Remove
    </button>
  </div>
</article>
<style>
  .cart-line {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) auto;
    grid-template-areas: 'image info total' 'image controls controls';
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
    min-width: 0;
  }
  .cart-line-image {
    grid-area: image;
    align-self: start;
    display: block;
  }
  .cart-line-image img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    height: auto;
    object-fit: contain;
    background: var(--paper-base);
  }
  .cart-line-info {
    grid-area: info;
    min-width: 0;
  }
  .cart-line-info h2 {
    font: 500 1.125rem/1.5 var(--mono);
    margin: 0 0 0.5rem;
    overflow-wrap: anywhere;
  }
  .cart-line-info h2 a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .cart-line-info h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .cart-line-info p {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--soft);
    overflow-wrap: anywhere;
  }
  .cart-line-total {
    grid-area: total;
    margin: 0;
    text-align: right;
    align-self: start;
  }
  .cart-line-total strong {
    display: block;
    font: 500 1.125rem/1.5 var(--mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cart-total-label {
    display: block;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--soft);
    margin-bottom: 0.25rem;
  }
  .cart-line-controls {
    grid-area: controls;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .cart-quantity {
    display: inline-grid;
    grid-template-columns: 2.75rem 3rem 2.75rem;
    border: 1px solid var(--line);
    background: var(--paper-base);
  }
  .cart-quantity button,
  .cart-quantity input {
    min-width: 0;
    width: 100%;
    height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: 400 1rem/1.5 var(--mono);
    text-align: center;
    padding: 0;
  }
  .cart-quantity button {
    display: grid;
    place-items: center;
  }
  .cart-quantity button:hover:not(:disabled) {
    background: #ededed;
  }
  .cart-quantity button:disabled {
    color: #767676;
    cursor: default;
  }
  .cart-quantity input {
    appearance: textfield;
    -moz-appearance: textfield;
    border-inline: 1px solid var(--line);
    border-radius: 0;
  }
  .cart-quantity input::-webkit-inner-spin-button,
  .cart-quantity input::-webkit-outer-spin-button {
    appearance: none;
    margin: 0;
  }
  .cart-digital-quantity {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.875rem;
  }
  .cart-remove {
    border: 0;
    background: transparent;
    color: var(--soft);
    min-height: 2.75rem;
    padding: 0.5rem 0;
    font: 400 0.875rem/1.5 var(--mono);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .cart-remove:hover {
    color: var(--ink);
  }
  @media (max-width: 35.999rem) {
    .cart-line {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      grid-template-areas: 'image info' 'image total' 'controls controls';
      column-gap: 1rem;
    }
    .cart-line-total {
      text-align: left;
      margin-top: 0.25rem;
    }
    .cart-total-label {
      display: none;
    }
    .cart-line-controls {
      margin-top: 0.25rem;
    }
  }
</style>
