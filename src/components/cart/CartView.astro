---
import TerminalButton from '../ui/TerminalButton.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import CartLine from './CartLine.astro';
import OrderTotals from './OrderTotals.astro';
import { storeProducts } from '../../lib/storefront';
---

<main id="main-content" class="vm-container cart-view">
  <Breadcrumbs items={[{ label: 'Cart' }]} />
  <header class="cart-heading">
    <div>
      <h1 class="page-title">Your cart</h1>
      <p>
        <span data-cart-count>0</span> <span data-cart-noun>items</span> selected
      </p>
    </div>
    <div class="cart-continue">
      <TerminalButton href="/shop/" label="Continue shopping" />
    </div>
  </header>
  <section class="cart-empty" data-cart-empty aria-labelledby="empty-cart-title">
    <h2 id="empty-cart-title">Your cart is empty.</h2>
    <p>Browse the digital collections and add one to your cart.</p>
    <div class="cart-empty-actions">
      <TerminalButton href="/shop/" label="Go to the shop" />
    </div>
  </section>
  <div class="cart-layout" data-cart-filled hidden>
    <section class="cart-items" aria-labelledby="cart-items-title">
      <h2 class="sr-only" id="cart-items-title">
        Products in your cart
      </h2>
      <!-- The wrapper scrolls sideways if the table is wider than the screen. -->
      <div class="table-responsive" role="region" aria-label="Cart table" tabindex="0">
        <table class="cart-table">
          <thead>
            <tr>
              <th scope="col">Product</th>
              <th scope="col">Price</th>
              <th scope="col">Quantity</th>
              <th scope="col">Total</th>
              <th scope="col">
                <span class="sr-only">Remove</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {storeProducts.map((product) => (
              <CartLine product={product} />
            ))}
          </tbody>
        </table>
      </div>
      <form class="cart-promo" data-cart-promo>
        <label for="promo-code">Promo code</label>
        <div class="cart-promo__field">
          <input
            id="promo-code"
            name="code"
            type="text"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="promo-hint promo-status"
          />
          <button class="cart-promo__apply" type="submit">
            Apply
          </button>
        </div>
        <p class="cart-promo__hint" id="promo-hint">
          Demo code: VISAMORE10 takes 10% off.
        </p>
        <p class="cart-promo__status" id="promo-status" role="status" data-cart-promo-status></p>
      </form>
    </section>
    <aside class="cart-summary" aria-labelledby="cart-summary-title">
      <h2 id="cart-summary-title">Order summary</h2>
      <OrderTotals />
      <TerminalButton href="/checkout/" label="Proceed to checkout" class="cart-summary__cta" />
      <p class="cart-summary__note">Your selection is saved in this browser.</p>
    </aside>
  </div>
  <noscript>
    <p>Enable JavaScript to add and review products in this cart.</p>
  </noscript>
</main>
