---
import { navigation } from '../../data/navigation';
import { getInformationEntries, informationPath } from '../../lib/information';
import { url } from '../../lib/paths';
const entries = await getInformationEntries();
const groups = [
  { title: 'Explore', links: navigation.filter((item) => item.key !== 'help') },
  ...(['support', 'policies'] as const).map((group) => ({
    title: group === 'support' ? 'Help' : 'Policies',
    links: entries
      .filter((entry) => entry.data.group === group)
      .map((entry) => ({
        label: entry.data.title,
        href: informationPath(entry),
      })),
  })),
];
---

<footer class="vm-footer vm-container">
  <div class="footer-grid">
    <div class="footer-intro">
      <a class="footer-brand" href={url('/')}>
        Visamore
      </a>
      <p>
        Digital artwork.
        <br />
        Objects in the making.
      </p>
      <p class="footer-preview">
        Store preview.
        <br />
        Orders are not open yet.
      </p>
    </div>
    {groups.map(({ title, links }) => (
      <nav aria-label={`${title} — footer`}>
        <h2>{title}</h2>
        <ul>
          {links.map(({ label, href }) => (
            <li>
              <a href={url(href)}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="footer-bottom">
    <span>Visamore · {new Date().getFullYear()}</span>
    <a href="#top">Back to top</a>
  </div>
</footer>

<style>
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.25rem;
  }
  .footer-intro {
    grid-column: 1 / -1;
  }
  .footer-intro p {
    margin: 0.5rem 0 0;
  }
  .footer-intro .footer-preview {
    margin-top: 1.25rem;
  }
  .footer-brand {
    font-weight: 500;
    font-size: 1.125rem;
    color: var(--ink);
  }
  nav h2 {
    font-size: 1rem;
    margin: 0.65rem 0 0.75rem;
    color: var(--ink);
  }
  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    padding-block: 0.5rem;
    line-height: 1.6;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--line);
    margin-top: 2rem;
    padding-top: 1rem;
  }
  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: 1.1fr 1fr 1fr 1.35fr;
      gap: 1.5rem;
    }
    .footer-intro {
      grid-column: auto;
    }
  }
  @media (max-width: 23rem) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
