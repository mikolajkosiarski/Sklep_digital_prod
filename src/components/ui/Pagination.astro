---
import { url } from '../../lib/paths';
interface Props {
  current: number;
  total: number;
  /** Site path for a page number, without the deployment base. */
  href: (page: number) => string;
  label: string;
  /** Optional data attribute hook for scripts. */
  hook?: string;
}
const { current, total, href, label, hook } = Astro.props;
const data = hook ? { [`data-${hook}`]: '' } : {};
---

<nav class="vm-pagination" aria-label={label} {...data}>
  {current > 1 ? (
    <a href={url(href(current - 1))} rel="prev">
      Previous
    </a>
  ) : (
    <span aria-disabled="true">Previous</span>
  )}
  <ol>
    {Array.from({ length: total }, (_, index) => index + 1).map((number) => (
      <li>
        <a
          href={url(href(number))}
          aria-label={`Page ${number}`}
          aria-current={number === current ? 'page' : undefined}
        >
          {number}
        </a>
      </li>
    ))}
  </ol>
  {current < total ? (
    <a href={url(href(current + 1))} rel="next">
      Next
    </a>
  ) : (
    <span aria-disabled="true">Next</span>
  )}
</nav>
