---
// Pixel icons drawn on a 24-unit grid to match the Terminal relic plus mark.
const paths = {
  trash: 'M9 2h6v2h5v2H4V4h5V2ZM5 8h14v14H5V8Zm2 2v10h10V10H7Zm2 1h2v8H9v-8Zm4 0h2v8h-2v-8Z',
  download: 'M11 2h2v10h2v-2h2v2h-2v2h-2v2h-2v-2H9v-2H7v-2h2v2h2V2ZM3 15h2v4h14v-4h2v6H3v-6Z',
  pencil:
    'M16 2h2v2h2v2h2v2h-2v2h-2v2h-2v2h-2v2h-2v2h-2v2H8v2H2v-6h2v-2h2v-2h2v-2h2V8h2V6h2V4h2V2Zm0 3v2h-2v2h-2v2h-2v2H8v2H6v2H4v3h3v-2h2v-2h2v-2h2v-2h2v-2h2V9h2V7h-2V5h-2Z',
  'check-circle':
    'M3 3h18v18H3V3Zm2 2v14h14V5H5Zm11 3h2v2h-2v2h-2v2h-2v2h-2v-2H8v-2h2v2h2v-2h2v-2h2V8Z',
} as const;

interface Props {
  name: keyof typeof paths;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<!-- Decorative: the control or text next to the icon carries the accessible name. -->
<svg class:list={['vm-icon', className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path d={paths[name]} fill="currentColor" fill-rule="evenodd"></path>
</svg>
