---
import { asset } from '../../lib/paths';
import TerminalButton from '../ui/TerminalButton.astro';
---

<div class="hero-shell">
  <section class="framed-hero" id="single-hero" aria-labelledby="framed-title">
    <div class="frame-stage">
      <div class="hero-ornaments" aria-hidden="true">
        <img
          class="hero-ornament hero-ornament--top-left"
          src={asset('assets/frames/parts/128/top-left-960.webp')}
          srcset={`${asset('assets/frames/parts/128/top-left-480.webp')} 480w, ${asset('assets/frames/parts/128/top-left-960.webp')} 960w`}
          sizes="(min-width: 768px) 448px, 160px"
          width="2229"
          height="2397"
          alt=""
        />
        <img
          class="hero-ornament hero-ornament--bottom-right"
          src={asset('assets/frames/parts/128/bottom-right-960.webp')}
          srcset={`${asset('assets/frames/parts/128/bottom-right-480.webp')} 480w, ${asset('assets/frames/parts/128/bottom-right-960.webp')} 960w`}
          sizes="(min-width: 768px) 448px, 160px"
          width="2226"
          height="2399"
          alt=""
        />
      </div>
      <div class="frame-content">
        <h1 class="frame-logo-heading" id="framed-title">
          <img
            class="frame-logo"
            src={asset('assets/visamore-tag.png')}
            width="1752"
            height="192"
            alt="Visamore"
            fetchpriority="high"
          />
        </h1>
        <p class="frame-description">Digital artwork &amp; apparel.</p>
        <TerminalButton href="#collections" label="Explore collections" class="frame-cta" />
      </div>
    </div>
  </section>
</div>
