---
import { featuredProducts } from '../../lib/catalog';
import { getStoreProduct } from '../../lib/storefront';
import { url } from '../../lib/paths';
import { decorImage } from '../../lib/decor-images';
import { mobileProductRail } from '../../lib/layout-classes';
import ProductCard from '../catalog/ProductCard.astro';
import TerminalButton from '../ui/TerminalButton.astro';
---

<!-- id="sklep": the shop section required by the course brief (CW5). -->
<section class="collections-section" id="sklep" aria-labelledby="collections-title">
  <!-- Decorative at 28% opacity: phones get the 640 px copy. -->
  <div class="collection-bleed" aria-hidden="true">
    <img
      {...decorImage('assets/digital/pack-300-3.png')}
      sizes="(min-width: 768px) 832px, 340px"
      width="4096"
      height="4096"
      alt=""
    />
  </div>
  <div class="vm-container">
    <div class="collections-intro">
      <h2 id="collections-title">
        <span>Selected</span> <span>collections.</span>
      </h2>
      <p>
        Digital artwork for your next composition. Browse PNG collections and Procreate brushsets.
      </p>
    </div>
    <div
      class:list={['product-grid product-grid--featured', mobileProductRail]}
      id="collection-products"
    >
      {featuredProducts.map((product) => (
        <ProductCard product={getStoreProduct(`digital:${product.id}`)} />
      ))}
    </div>
    <div class="collections-catalog-link">
      <TerminalButton label="Browse the shop" href={url('/shop/')} />
    </div>
  </div>
</section>
