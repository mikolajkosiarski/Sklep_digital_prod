---
import { digitalProducts } from '../../lib/catalog';
import { getStoreProduct } from '../../lib/storefront';
import CatalogControls from './CatalogControls.astro';
import ProductCard from './ProductCard.astro';
const options: [string, string][] = [
  ['all', 'All collections'],
  ['brushes', 'With Procreate brushes'],
  ['png', 'PNG only'],
];
---

<section class="catalog-browser" data-catalog aria-label="Digital design collections">
  <CatalogControls options={options} count={digitalProducts.length} noun="collections" />
  <div class="product-grid" id="catalog-items">
    {digitalProducts.map((product) => (
      <div class="catalog-item" data-category={product.brushes ? 'brushes' : 'png'}>
        <ProductCard product={getStoreProduct(`digital:${product.id}`)} headingLevel={2} />
      </div>
    ))}
  </div>
</section>
