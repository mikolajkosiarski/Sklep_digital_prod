---
import type { StoreProduct } from '../../lib/storefront';
import { formatMoney } from '../../lib/money';
import TerminalButton from '../ui/TerminalButton.astro';
import StarRating from '../ui/StarRating.astro';

interface Props {
  product: StoreProduct;
  headingLevel?: 2 | 3;
}
const { product, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<article class="product-card" data-product-card={product.key}>
  <!-- The title link is the card's single tab stop; the image repeats it for pointer users. -->
  <a class="product-card__image" href={product.href} tabindex="-1" aria-hidden="true">
    <img
      src={product.image.src}
      srcset={product.image.srcset}
      sizes="(min-width: 75rem) 360px, (min-width: 48rem) 44vw, 90vw"
      alt={product.image.alt}
      width={product.image.width}
      height={product.image.height}
      loading="lazy"
      decoding="async"
    />
  </a>
  {product.badge && <p class="product-card__badge">{product.badge}</p>}
  <div class="product-card__body">
    <Heading class="product-card__title">
      <a href={product.href}>{product.title}</a>
    </Heading>
    <p class="product-card__meta">Digital · {product.meta}</p>
    {product.rating && (
      <StarRating
        class="product-card__rating"
        average={product.rating.average}
        count={product.rating.count}
      />
    )}
    <div class="product-card__purchase">
      <p class="product-card__price">
        {product.compareAtMinor && (
          <s class="product-card__regular">
            <span class="sr-only">Regular price </span>
            {formatMoney(product.compareAtMinor)}
          </s>
        )}
        <span>
          {product.compareAtMinor && <span class="sr-only">Sale price </span>}
          {formatMoney(product.priceMinor)}
        </span>
      </p>
      <TerminalButton
        href={product.href}
        label="View details"
        ariaLabel={`View details: ${product.title}`}
      />
    </div>
  </div>
</article>
