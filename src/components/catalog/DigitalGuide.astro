---
import { digitalProducts, digitalPath } from '../../lib/catalog';
import { url } from '../../lib/paths';
import TerminalButton from '../ui/TerminalButton.astro';
---

<section class="file-guide editorial-section" aria-labelledby="file-guide-title">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-8 gap-y-6">
    <div class="min-w-0 lg:col-span-5">
      <h2 class="section-heading" id="file-guide-title">
        Inside the files.
      </h2>
      <p class="editorial-copy">
        Every collection includes transparent and white-background PNG files. The table shows which
        packs also include a Procreate brushset.
      </p>
      <TerminalButton label="PNG or .brushset?" href={url('/journal/png-or-brushset/')} />
    </div>
    <div class="min-w-0 lg:col-span-7">
      <table class="format-comparison">
        <caption>File formats included in each digital collection.</caption>
        <thead>
          <tr>
            <th scope="col">Collection</th>
            <th scope="col">Images</th>
            <th scope="col">Procreate brushes</th>
          </tr>
        </thead>
        <tbody>
          {digitalProducts.map((product) => (
            <tr>
              <th scope="row">
                <a href={url(digitalPath(product))}>{product.designCount} designs</a>
              </th>
              <td>PNG</td>
              <td>{product.brushes ? 'Included' : 'Not included'}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="download-note">
        <h3>Inside the download</h3>
        <p>
          Collections are supplied through a delivery PDF or ZIP archives. Each product page lists
          its files and packaging.
        </p>
      </div>
    </div>
  </div>
</section>
