---
import { physicalProducts } from '../../lib/catalog';
import { getStoreProduct } from '../../lib/storefront';
import CatalogControls from './CatalogControls.astro';
import ProductCard from './ProductCard.astro';
const groups = new Set(physicalProducts.map(({ group }) => group));
const groupOptions: [string, string][] = [
  ['gothic', 'Gothic'],
  ['color', 'Color studies'],
];
const options: [string, string][] =
  groups.size > 1
    ? [['all', 'All studies'], ...groupOptions.filter(([key]) => groups.has(key))]
    : [];
---

<section class="catalog-browser" data-catalog aria-label="Apparel concepts">
  <CatalogControls options={options} count={physicalProducts.length} noun="studies" />
  <div class="product-grid" id="catalog-items">
    {physicalProducts.map((product) => (
      <div class="catalog-item" data-category={product.group}>
        <ProductCard product={getStoreProduct(`physical:${product.slug}`)} headingLevel={2} />
      </div>
    ))}
  </div>
</section>
