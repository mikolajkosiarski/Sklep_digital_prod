---
import { physicalProducts, physicalPath } from '../../lib/catalog';
import { url } from '../../lib/paths';
const notes: Record<string, { title: string; text: string }> = {
  'bat-skeleton': {
    title: 'A wide silhouette.',
    text: 'Extended wings spread outward from a narrow centre. Fine skeletal lines give the bat its structure, while worn edges soften the white graphic.',
  },
  'open-mouth': {
    title: 'A vertical focal point.',
    text: 'The tall mouth shape surrounds a central cross. Distressed edges break up the solid white areas and keep the focus on the centre of the print.',
  },
};
---

<section class="editorial-section physical-notes" aria-labelledby="design-notes-title">
  <h2 class="section-heading" id="design-notes-title">
    Design notes.
  </h2>
  <p class="editorial-copy">Two different ways to place a graphic on clothing.</p>
  <div class="design-notes-grid grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
    {physicalProducts
      .filter((product) => Object.hasOwn(notes, product.slug))
      .map((product) => (
        <div>
          <article class="design-note">
            <h3>{notes[product.slug].title}</h3>
            <p>{notes[product.slug].text}</p>
            <a href={url(physicalPath(product))}>{product.title}</a>
          </article>
        </div>
      ))}
  </div>
</section>
