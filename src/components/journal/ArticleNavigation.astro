---
import { url } from '../../lib/paths';
import type { JournalEntry } from './entries';
interface Props {
  previous?: JournalEntry;
  next?: JournalEntry;
}
const { previous, next } = Astro.props;
---

<nav class="journal-article-nav" aria-label="Article navigation">
  {previous ? (
    <a href={url(`/journal/${previous.id}/`)} rel="prev">
      <span>Previous note</span> <strong>{previous.data.title}</strong>
    </a>
  ) : (
    <div>
      <span>Previous note</span>
      <p>You’re at the start of the journal.</p>
    </div>
  )}
  {next ? (
    <a href={url(`/journal/${next.id}/`)} rel="next">
      <span>Next note</span> <strong>{next.data.title}</strong>
    </a>
  ) : (
    <div>
      <span>Next note</span>
      <p>You’ve reached the last note.</p>
    </div>
  )}
</nav>
