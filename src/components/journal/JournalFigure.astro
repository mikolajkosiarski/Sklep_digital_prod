---
import { decorImage } from '../../lib/decor-images';
import type { JournalEntry } from './entries';
interface Props {
  figure: JournalEntry['data']['figure'];
}
const { figure } = Astro.props;
---

<figure class="journal-detail-figure">
  <img
    {...decorImage(figure.image)}
    sizes="(min-width: 768px) 768px, 100vw"
    alt={figure.alt}
    loading="lazy"
    decoding="async"
  />
  <figcaption>{figure.caption}</figcaption>
</figure>
