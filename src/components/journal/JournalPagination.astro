---
import Pagination from '../ui/Pagination.astro';
interface Props {
  page: number;
  pages: number;
}
const { page, pages } = Astro.props;
---

<Pagination
  current={page}
  total={pages}
  href={(number) => (number === 1 ? '/journal/' : `/journal/page/${number}/`)}
  label="Journal pages"
  hook="journal-pagination"
/>
