---
import { asset } from '../../lib/paths';
import type { JournalEntry } from './entries';

interface Props {
  art: JournalEntry['data']['art'];
  /** Set on article headers, where the cover is described; cards stay decorative. */
  labelled?: boolean;
}

const { art, labelled = false } = Astro.props;
const { layout, design, alt } = art;
// Each chosen design has 560 and 1000 px greyscale WebP copies in public/assets/journal.
const image = {
  src: asset(`assets/journal/${design}-1000.webp`),
  srcset: `${asset(`assets/journal/${design}-560.webp`)} 560w, ${asset(`assets/journal/${design}-1000.webp`)} 1000w`,
  width: 1000,
  height: 1000,
  alt: '',
  loading: 'lazy' as const,
  decoding: 'async' as const,
};
---

<div
  class:list={['journal-visual', `journal-visual--${layout}`]}
  role={labelled ? 'img' : undefined}
  aria-label={labelled ? alt : undefined}
  aria-hidden={labelled ? undefined : 'true'}
>
  {layout === 'formats' ? (
    <>
      <div class="format-panel">
        <img {...image} sizes="(min-width: 768px) 320px, 45vw" />
        <span>.png</span>
      </div>
      <div class="format-panel">
        <div class="brush-stamps">
          {[1, 2, 3].map(() => (
            <img {...image} sizes="(min-width: 768px) 160px, 25vw" />
          ))}
        </div>
        <span>.brushset</span>
      </div>
    </>
  ) : layout === 'texture' ? (
    <>
      <span class="texture-piece" />
      <img class="texture-design" {...image} sizes="(min-width: 768px) 480px, 90vw" />
    </>
  ) : (
    <img class="single-design" {...image} sizes="(min-width: 768px) 480px, 90vw" />
  )}
</div>
