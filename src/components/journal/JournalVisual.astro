---
import { decorImage } from '../../lib/decor-images';
import type { JournalEntry } from './entries';

interface Props {
  kind: JournalEntry['data']['art'];
  label?: string;
}

const { kind, label } = Astro.props;
---

<div
  class:list={['journal-visual', `journal-visual--${kind}`]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  {kind === 'formats' ? (
    <>
      <div class="format-panel">
        <img
          {...decorImage('assets/digital/pack-100-3.png')}
          sizes="(min-width: 768px) 320px, 45vw"
          width="4096"
          height="2048"
          alt=""
          loading="lazy"
        />
        <span>.png</span>
      </div>
      <div class="format-panel">
        <div class="brush-stamps">
          {[1, 2, 3].map(() => (
            <img
              {...decorImage('assets/digital/pack-100-3.png')}
              sizes="(min-width: 768px) 160px, 25vw"
              width="4096"
              height="2048"
              alt=""
              loading="lazy"
            />
          ))}
        </div>
        <span>.brushset</span>
      </div>
    </>
  ) : kind === 'ornaments' ? (
    <img
      {...decorImage('assets/digital/pack-121-3.png')}
      sizes="(min-width: 768px) 480px, 90vw"
      width="4096"
      height="4096"
      alt=""
      loading="lazy"
    />
  ) : (
    <>
      <span class="texture-piece" />
      <span class="texture-piece" />
    </>
  )}
</div>
