---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhysicalCatalog from '../../components/catalog/PhysicalCatalog.astro';
import PhysicalNotes from '../../components/catalog/PhysicalNotes.astro';
import NextSection from '../../components/catalog/NextSection.astro';
import { collectionSchema, physicalProducts, physicalPath } from '../../lib/catalog';
import { url } from '../../lib/paths';
const schema = {
  ...collectionSchema('Visamore physical studies', physicalProducts, physicalPath, Astro.site),
  description: 'Draft apparel concepts shown with saved listing mockups. Not available to order.',
};
---

<BaseLayout
  title="Physical studies — Visamore"
  description="Explore five Visamore apparel concepts with gothic graphics and saved T-shirt listing mockups."
  section="physical"
  schema={schema}
  ogImage={physicalProducts[0].image}
  ogAlt="Physical studies — Visamore"
>
  <main id="main-content" class="vm-container">
    <header class="catalog-header">
      <h1 class="page-title">Physical studies.</h1>
      <p class="page-intro">
        Dark forms. Worn graphics.
        <br />
        Gothic apparel ideas from the Visamore archive.
      </p>
      <p class="catalog-status">
        Concepts in development, shown with saved listing mockups. Not available to order.
      </p>
    </header>
    <PhysicalCatalog />
    <PhysicalNotes />
    <NextSection
      id="digital-next"
      title="Start with a graphic."
      description="Explore the digital collections behind this visual direction."
      label="Explore digital"
      href={url('/digital/')}
    />
  </main>
</BaseLayout>
<script>
  import '../../scripts/catalog';
</script>
