---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhysicalImage from '../../components/catalog/PhysicalImage.astro';
import TerminalButton from '../../components/ui/TerminalButton.astro';
import ProductPrice from '../../components/product/ProductPrice.astro';
import ProductCard from '../../components/catalog/ProductCard.astro';
import { getStoreProduct } from '../../lib/storefront';
import { physicalProducts } from '../../lib/catalog';
import { url } from '../../lib/paths';
export const getStaticPaths = (() =>
  physicalProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { product } = Astro.props;
const title = `${product.title} · apparel concept`;
const related = physicalProducts
  .filter((other) => other.slug !== product.slug)
  .sort((a, b) => Number(a.group !== product.group) - Number(b.group !== product.group))
  .slice(0, 2);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${product.title} — apparel concept`,
  description:
    'Draft apparel concept, illustrated with a saved listing mockup. Not available to order.',
};
---

<BaseLayout
  title={`${title} — Visamore`}
  description={`${product.description} A draft shown with a saved listing mockup, not available to order.`}
  section="physical"
  schema={schema}
  ogImage={product.image}
  ogAlt={`${title} — Visamore`}
>
  <main id="main-content" class="vm-container">
    <nav class="detail-back" aria-label="Breadcrumb">
      <a href={url('/physical/')}>Physical studies</a>
      <span aria-hidden="true">/</span>
      <span>{product.title}</span>
    </nav>
    <article class="grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-6 items-center">
      <div class="physical-detail-visual min-w-0 col-span-full md:col-span-6">
        <PhysicalImage product={product} />
        <p class="catalog-footnote">Saved listing image · product mockup</p>
      </div>
      <div class="detail-copy min-w-0 col-span-full md:col-span-6">
        <h1 class="page-title">{product.title}.</h1>
        <p class="concept-label">Apparel concept · draft</p>
        <ProductPrice productKey={`physical:${product.slug}`} />
        <p>{product.description}</p>
        <dl class="product-facts">
          <div>
            <dt>Stage</dt>
            <dd>Visual exploration</dd>
          </div>
          <div>
            <dt>Preview</dt>
            <dd>Saved product listing mockup</dd>
          </div>
          <div>
            <dt>Next steps</dt>
            <dd>Garment selection, print placement and a physical sample</dd>
          </div>
        </dl>
        <p class="catalog-status">In development. Not available to order.</p>
        <TerminalButton label="Add to cart" cartKey={`physical:${product.slug}`} />
        <TerminalButton label="All physical studies" href={url('/physical/')} />
      </div>
    </article>
    <section
      class="catalog-next grid grid-cols-1 md:grid-cols-12 gap-x-8 gap-y-6 items-center"
      aria-labelledby="next-study"
    >
      <div class="min-w-0 col-span-full md:col-span-8">
        <h2 class="section-heading" id="next-study">
          Another direction.
        </h2>
        <p>Explore the next apparel concept.</p>
      </div>
      <div class="min-w-0 col-span-full">
        <div class="product-grid">
          {related.map((other) => (
            <ProductCard product={getStoreProduct(`physical:${other.slug}`)} />
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
