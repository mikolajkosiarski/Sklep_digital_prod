---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import InformationPage from '../layouts/InformationPage.astro';
import { getInformationEntries } from '../lib/information';

export const getStaticPaths = (async () =>
  (await getInformationEntries())
    .filter((entry) => entry.id !== 'contact')
    .map((entry) => ({
      params: { information: entry.id },
      props: { entry },
    }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<InformationPage entry={entry} headings={headings}>
  <Content />
</InformationPage>
