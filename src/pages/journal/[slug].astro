---
import { render } from 'astro:content';
import JournalPost from '../../layouts/JournalPost.astro';
import { getJournalEntries, type JournalEntry } from '../../components/journal/entries';

export async function getStaticPaths() {
  const articles = await getJournalEntries();
  return articles.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      related: articles.filter((other) => other.id !== entry.id).slice(0, 2),
      previous: articles[index - 1],
      next: articles[index + 1],
    },
  }));
}

interface Props {
  entry: JournalEntry;
  related: JournalEntry[];
  previous?: JournalEntry;
  next?: JournalEntry;
}

const { entry, related, previous, next } = Astro.props;
const { Content } = await render(entry);
---

<JournalPost entry={entry} related={related} previous={previous} next={next}>
  <Content />
</JournalPost>
